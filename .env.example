# IServ Konfiguration (Lokal auf deinem Rechner)
# Erstelle eine Kopie namens .env und trage dort deine Daten ein.
# Diese Datei (.env) wird per .gitignore NIEMALS auf GitHub hochgeladen!

ISERV_SERVER=deine-schule.iserv.de
ISERV_USERNAME=vorname.nachname
ISERV_PASSWORD=dein_passwort_oder_app_passwort
ISERV_AUTO_SYNC_MINUTES=30
